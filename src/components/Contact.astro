---
import InquiryForm from './InquiryForm.astro';
import { site } from '../data/site';
interface Props { preselect?: string }
const { preselect } = Astro.props;
---
<section class="section section--cream" id="kontakt">
  <div class="container contact">
    <div>
      <span class="kicker">Kontakt</span>
      <h2 style="margin-top: 0.75rem">Kontaktujte <em>nás.</em></h2>
      <p class="lead" style="margin-top: 1rem">Napíšte nám alebo zavolajte, radi pripravíme ponuku pre váš event. Odpisujeme zvyčajne do 24 hodín.</p>
      <ul class="contact__list">
        <li><a href={site.phoneHref}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>{site.email}</a></li>
        <li><a href={site.instagram.url} target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>{site.instagram.handle}</a></li>
        <li><span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><span>{site.company.name}<br />{site.company.address.join(', ')}<br />IČO: {site.company.ico}</span></span></li>
      </ul>
    </div>
    <InquiryForm preselect={preselect} />
  </div>
</section>
