---
import Base from '../layouts/Base.astro';
---
<Base title="Stránka sa nenašla">
  <section class="section">
    <div class="container" style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem">
      <img src="/images/ilustracie/oldfashioned.svg" alt="" width="360" height="270" style="border-radius: 20px" />
      <h1>Tento drink <em>nemáme.</em></h1>
      <p class="lead">Stránka, ktorú hľadáte, neexistuje alebo sa presunula.</p>
      <a href="/" class="btn btn--primary">Späť na úvod</a>
    </div>
  </section>
</Base>
