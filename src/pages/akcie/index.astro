---
import Base from '../../layouts/Base.astro';
import AkciaCard from '../../components/AkciaCard.astro';
import Contact from '../../components/Contact.astro';
import { akcie } from '../../data/akcie';
---
<Base title="Akcie" description="Mobilný bar na event, koktailové workshopy pre firmy a tastingy. Sip Spot, po celom Slovensku.">
  <section class="section" style="padding-bottom: 2rem">
    <div class="container">
      <span class="kicker">Akcie a zážitky</span>
      <h1 style="margin-top: 0.75rem; max-width: 16ch">Bar, tasting alebo workshop. <em>Vy poviete kedy a kde.</em></h1>
    </div>
  </section>
  <section class="section" style="padding-top: 1rem">
    <div class="container grid grid--3">
      {akcie.map((a, i) => <AkciaCard akcia={a} highlight={i === 1} />)}
    </div>
  </section>
  <Contact />
</Base>
